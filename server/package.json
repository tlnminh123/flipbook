{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.js",
    "db:import-xml": "node --env-file=.env --import tsx scripts/import-xml.js",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.js",
    "admin:check": "node --env-file=.env --import tsx scripts/check-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
